# Admin login (/admin). Keep these secret - set them in Vercel > Project > Settings > Environment Variables.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random string of at least 32 characters, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=

# Upstash Redis (stores admin price/stock edits). Added automatically when you connect
# an Upstash Redis database from the Vercel Marketplace (Storage tab).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (photo uploads for products added in the admin panel). Added automatically when
# you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Ordering backend on Azure (nationwide checkout with cash on delivery). Leave empty to keep the
# WhatsApp ordering flow. Keys are the Key Vault secrets storefront-api-key and admin-api-key.
BACKEND_API_URL=
BACKEND_STOREFRONT_KEY=
BACKEND_ADMIN_KEY=
